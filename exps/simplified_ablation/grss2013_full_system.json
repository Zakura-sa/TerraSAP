{
  "model_name": "asp",
  "backbone_type": "pretrained_vit_b16_224_vpt",
  "device": ["0"],
  "seed": [2025],

  "dataset": "grss2013",
  "init_cls": 7,
  "increment": 2,
  "kshot": 5,

  "vpt_type": "Deep",
  "prompt_token_num": 6,
  "avg_alpha": 0.8,
  "perturb_var": 1.0,
  "EMA_beta": 0.995,
  "anchor_lambda": 0.08,
  "kl_weight": 0.0008,
  "TIP_init": "zero",

  "tuned_epoch": 55,
  "fs_epoch": 0,
  "init_lr": 0.0018,
  "fs_lr": 0.0018,
  "batch_size": 24,
  "fs_batch_size": 24,
  "weight_decay": 0.0005,
  "min_lr": 0,
  "optimizer": "adamw",

  "memory_size": 150,
  "memory_per_class": 6,
  "fixed_memory": false,
  "shuffle": true,
  "top_k": 4,
  "prefix": "simplified_ablation_grss2013_full_system",
  "model_prefix": "simplified_ablation_grss2013_full_system",

  "_comment": "Houston 2013 FSCIL experiment (Base7 + 4 increments, 5-shot).",
  "_experiment_name": "Houston2013 Full System",
  "_experiment_type": "grss2013_full_system",
  "_description": "TerraSAP full system on Houston 2013 with PCA patches.",

  "_comment_spatial_prompts": "Spatial prompt configuration",
  "spatial_aware_prompts": true,
  "spatial_position_encoding": true,
  "relative_position_attention": true,
  "spatial_relation_weight": 0.35,
  "position_encoding_type": "sinusoidal_2d",
  "spatial_relation_mode": "compress_expand",

  "_comment_lightweight_modulation": "Lightweight feature modulation",
  "enable_feature_modulation": true,
  "modulation_version": "v1",
  "modulation_strength": 0.1,
  "adaptive_modulation_strength": false,
  "min_modulation_strength": 0.01,
  "max_modulation_strength": 0.2,

  "_comment_new_class_aware": "New class-aware classifier",
  "enable_new_class_aware_classifier": true,
  "new_class_init_strategy": "class_prototype",
  "new_class_noise_scale": 0.1,
  "new_class_use_fallback": true,

  "_comment_layered_lr": "Layered learning rates",
  "use_layered_lr": true,
  "backbone_lr_ratio": 0.07,
  "prompt_lr_ratio": 1.0,
  "spatial_prompt_lr_ratio": 1.3,
  "classifier_lr_ratio": 0.8,
  "consistency_lr_ratio": 0.6,

  "_comment_stage1_enabled": "Stage-1 spatial context transfer",
  "enable_spatial_context_transfer": true,
  "spatial_context_dim": 128,
  "enable_spatial_context_modulation": true,
  "enable_spatial_context_pipeline": true,
  "enable_spatial_aware_classifier_init": true,

  "_comment_stage2_enabled": "Stage-2 dual-path EMA fusion",
  "enable_dual_path_ema": true,
  "dual_ema_fusion_weight": 0.45,
  "adaptive_fusion_strategy": "dynamic",
  "fusion_adaptation_rate": 0.1,
  "enable_ema_stability_monitoring": true,

  "_comment_validation": "Debug/validation flags",
  "enable_collaborative_debug": true,
  "log_spatial_context_stats": true,
  "log_ema_fusion_stats": true,
  "log_multiscale_stats": false,
  "enable_compatibility_check": true
}
