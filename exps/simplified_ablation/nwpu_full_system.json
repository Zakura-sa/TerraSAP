{
  "model_name": "asp",
  "backbone_type": "pretrained_vit_b16_224_vpt",
  "device": ["0"],
  "seed": [2025],

  "dataset": "nwpu",
  "init_cls": 25,
  "increment": 5,
  "kshot": 5,
  
  "vpt_type": "Deep",
  "prompt_token_num": 6,
  "avg_alpha": 0.8,
  "perturb_var": 1.0,
  "EMA_beta": 0.995,
  "anchor_lambda": 0.07,
  "kl_weight": 0.001,
  "TIP_init": "zero",
  
  "tuned_epoch": 40,
  "fs_epoch": 0,
  "init_lr": 0.007,
  "fs_lr": 0.001,
  "batch_size": 16,
  "fs_batch_size": 16,
  "weight_decay": 0.0005,
  "min_lr": 0,
  "optimizer": "sgd",
  
  "memory_size": 0,
  "memory_per_class": 0,
  "fixed_memory": false,
  "shuffle": false,
  "top_k": 5,
  "prefix": "simplified_ablation_nwpu_full_system",
  "model_prefix": "simplified_ablation_nwpu_full_system",
  
  "_comment": "=== 精简消融实验4：完整系统（新旧类平衡优化） ===",
  "_experiment_name": "Simplified Ablation: Full System",
  "_experiment_type": "simplified_full_system",
  "_description": "Complete system with all modules including dual-path EMA for new-old class balance optimization",
  "_modules_enabled": "All Modules: Spatial Prompts + Feature Modulation + Stage1 Context Transfer + New Class Aware Classifier + Dual-Path EMA",

  "_comment_spatial_prompts": "=== 空间提示学习模块配置（启用） ===",
  "spatial_aware_prompts": true,
  "spatial_position_encoding": true,
  "relative_position_attention": true,
  "spatial_relation_weight": 0.35,
  "position_encoding_type": "sinusoidal_2d",
  "spatial_relation_mode": "compress_expand",

  "_comment_lightweight_modulation": "=== 轻量级特征调制v1配置（启用） ===",
  "enable_feature_modulation": true,
  "modulation_version": "v1",
  "modulation_strength": 0.1,
  "adaptive_modulation_strength": false,
  "min_modulation_strength": 0.01,
  "max_modulation_strength": 0.2,

  "_comment_new_class_aware": "=== 新类感知分类器配置（启用） ===",
  "enable_new_class_aware_classifier": true,
  "new_class_init_strategy": "class_prototype",
  "new_class_noise_scale": 0.1,
  "new_class_use_fallback": true,

  "_comment_layered_lr": "=== 分层学习率配置（启用） ===",
  "use_layered_lr": true,
  "backbone_lr_ratio": 0.07,
  "prompt_lr_ratio": 1.0,
  "spatial_prompt_lr_ratio": 1.3,
  "classifier_lr_ratio": 0.8,
  "consistency_lr_ratio": 0.6,

  "_comment_stage1_enabled": "=== 阶段1：空间信息跨模块传递机制（启用） ===",
  "enable_spatial_context_transfer": true,
  "spatial_context_dim": 128,
  "enable_spatial_context_modulation": true,
  "enable_spatial_context_pipeline": true,
  "enable_spatial_aware_classifier_init": true,

  "_comment_stage2_enabled": "=== 阶段2：EMA-调制协同机制（启用） ===",
  "enable_dual_path_ema": true,
  "dual_ema_fusion_weight": 0.45,
  "adaptive_fusion_strategy": "dynamic",
  "fusion_adaptation_rate": 0.1,
  "enable_ema_stability_monitoring": true,

  "_comment_validation": "--- 验证和调试配置 ---",
  "enable_collaborative_debug": true,
  "log_spatial_context_stats": true,
  "log_ema_fusion_stats": true,
  "log_multiscale_stats": false,
  "enable_compatibility_check": true
}
