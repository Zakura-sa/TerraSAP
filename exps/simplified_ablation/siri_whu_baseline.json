{
  "model_name": "asp",
  "backbone_type": "pretrained_vit_b16_224_vpt",
  "device": ["1"],
  "seed": [2024, 2025, 42,3407],
  "enable_multi_seed_validation": true,
  "seed_aggregation_strategy": "mean_std",
  "enable_tsne_visualization": true,

  "_comment_early_stopping": "=== 早停机制配置（禁用以充分训练） ===",
  "enable_early_stopping": false,
  "early_stopping_patience": 40,
  "early_stopping_metric": "test_acc",
  "early_stopping_min_delta": 0.001,
  
  "_comment_fact_preprocessing": "=== FACT风格数据预处理配置 ===",
  "enable_fact_preprocessing": true,
  "enable_fact_autoaugment": true,
  
  "dataset": "siri_whu",
  "init_cls": 6,
  "increment": 2,
  "kshot": 5,
  
  "vpt_type": "Deep",
  "prompt_token_num": 6,
  "avg_alpha": 0.8,
  "perturb_var": 1.0,
  "EMA_beta": 0.995,
  "anchor_lambda": 0.06,
  "kl_weight": 0.001,
  "TIP_init": "zero",
  
  "tuned_epoch": 40,
  "fs_epoch": 0,
  "init_lr": 0.008,
  "fs_lr": 0.001,
  "batch_size": 16,
  "fs_batch_size": 16,
  "weight_decay": 0.0005,
  "min_lr": 0,
  "optimizer": "sgd",
  
  "memory_size": 0,
  "memory_per_class": 0,
  "fixed_memory": false,
  "shuffle": false,
  "top_k": 5,
  "prefix": "simplified_ablation_siri_whu_baseline",
  "model_prefix": "simplified_ablation_siri_whu_baseline",
  
  "_comment": "=== 精简消融实验1：ASP基线 (SIRI-WHU) ===",
  "_experiment_name": "Simplified Ablation: ASP Baseline (SIRI-WHU)",
  "_experiment_type": "simplified_baseline",
  "_description": "Original ASP method without any innovative modules - serves as technical baseline for SIRI-WHU dataset",
  "_modules_enabled": "None - all innovative modules disabled",

  "_comment_spatial_prompts": "=== 空间提示学习模块配置（禁用） ===",
  "spatial_aware_prompts": false,
  "spatial_position_encoding": false,
  "relative_position_attention": false,
  "spatial_relation_weight": 0.35,
  "position_encoding_type": "sinusoidal_2d",
  "spatial_relation_mode": "compress_expand",

  "_comment_lightweight_modulation": "=== 轻量级特征调制v1配置（禁用） ===",
  "enable_feature_modulation": false,
  "modulation_version": "v1",
  "modulation_strength": 0.1,
  "adaptive_modulation_strength": false,
  "min_modulation_strength": 0.01,
  "max_modulation_strength": 0.2,

  "_comment_new_class_aware": "=== 新类感知分类器配置（禁用） ===",
  "enable_new_class_aware_classifier": false,
  "new_class_init_strategy": "class_prototype",
  "new_class_noise_scale": 0.1,
  "new_class_use_fallback": false,

  "_comment_layered_lr": "=== 分层学习率配置（启用） ===",
  "use_layered_lr": true,
  "backbone_lr_ratio": 0.07,
  "prompt_lr_ratio": 1.0,
  "spatial_prompt_lr_ratio": 1.3,
  "classifier_lr_ratio": 0.8,
  "consistency_lr_ratio": 0.6,

  "_comment_stage1_disabled": "=== 阶段1：空间信息跨模块传递机制（禁用） ===",
  "enable_spatial_context_transfer": false,
  "spatial_context_dim": 128,
  "enable_spatial_context_modulation": false,
  "enable_spatial_context_pipeline": false,
  "enable_spatial_aware_classifier_init": false,

  "_comment_stage2_disabled": "=== 阶段2：EMA-调制协同机制（禁用） ===",
  "enable_dual_path_ema": false,
  "dual_ema_fusion_weight": 0.45,
  "adaptive_fusion_strategy": "dynamic",
  "fusion_adaptation_rate": 0.1,
  "enable_ema_stability_monitoring": false,

  "_comment_validation": "--- 验证和调试配置 ---",
  "enable_collaborative_debug": true,
  "log_spatial_context_stats": false,
  "log_ema_fusion_stats": false,
  "log_multiscale_stats": false,
  "enable_compatibility_check": true
}
